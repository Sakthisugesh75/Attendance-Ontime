# Settings for the AWS server. Copy to .env in the app folder on the server and fill in:
#   cp deploy/aws/env.example .env && nano .env
# Make each secret long and random:  openssl rand -base64 32

# The address staff will open (no https://). Must point at the server's static IP first.
DOMAIN="attendance.example.com"
APP_URL="https://attendance.example.com"

# Database password (only used inside the server; never opened to the internet).
MYSQL_ROOT_PASSWORD=""

# Sign-in sessions and the scheduled jobs.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
CRON_SECRET=""

# Email (optional; without SMTP_HOST mails are only written to the app log).
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (Google account → Security).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Attendance <no-reply@example.com>"
