# MySQL 8 connection
DATABASE_URL="mysql://root:password@127.0.0.1:3306/attendance_next"
# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Public URL of the app (used in emails and password-reset links)
APP_URL="http://localhost:6001"
# Shared secret for /api/cron/* (send as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=""
# SMTP for emails; leave SMTP_HOST empty in development to print emails to the server log
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Attendance <no-reply@example.com>"

# Optional: a named Cloudflare Tunnel for a fixed https address (npm run tunnel). Without it, npm run tunnel uses a free random trycloudflare.com address.
CLOUDFLARE_TUNNEL_TOKEN=""
