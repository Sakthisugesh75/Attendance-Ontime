{
  "name": "attendance-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/free-port.mjs 6001",
    "dev": "next dev --turbopack -p 6001",
    "build": "next build",
    "prestart": "node scripts/free-port.mjs 6001",
    "start": "node scripts/serve.mjs",
    "serve": "nodemon",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "preprod": "node scripts/free-port.mjs 6001",
    "prod": "next build && next start -p 6001",
    "tunnel": "node scripts/tunnel.mjs",
    "bundle": "node scripts/bundle.mjs",
    "export-db": "node scripts/export-db.mjs",
    "postinstall": "prisma generate",
    "bundle:cpanel": "next build && node scripts/bundle.mjs --cpanel",
    "release:android": "npm --prefix mobile run release:android",
    "publish:apk": "npm --prefix mobile run publish:apk"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  }
}
